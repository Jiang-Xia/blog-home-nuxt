# 本地前端 dev → 线上 Go 单体（Nginx /x-blog-go/api/v1 → :8000）
# 用法：pnpm dev:go-online
# 浏览器 /blog-api → Nitro devProxy → https://jiang-xia.top/x-blog-go/api/v1
# WebSocket：wss://jiang-xia.top/realtime（jiang-xia.top.conf 反代 Go）

VITE_ENV = development

VITE_NUXT_ORIGIN_URL = https://jiang-xia.top
VITE_NUXT_API_PREFIX = /x-blog-go/api/v1
VITE_NUXT_ADMIN_URL = http://localhost:9856

VITE_NUXT_PREFIX_PATH = /blog-api
VITE_NUXT_OPEN_ENCRYPT = false

VITE_NUXT_STATIC_ORIGIN_URL = https://jiang-xia.top
