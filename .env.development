VITE_ENV = development

# 本地 Go gateway（make dev-all / dev-all.ps1 → :8000）
VITE_NUXT_ORIGIN_URL = http://localhost:8000
VITE_NUXT_API_PREFIX = /api/v1
VITE_NUXT_ADMIN_URL = http://localhost:9856

# --- 其他联调场景 ---
# 线上 Go：VITE_NUXT_ORIGIN_URL = https://jiang-xia.top  VITE_NUXT_API_PREFIX = /x-blog-go/api/v1
# 线上 Nest：VITE_NUXT_ORIGIN_URL = https://jiang-xia.top  VITE_NUXT_API_PREFIX = /x-blog/api/v1
# 本机 Nest / Go 单体：VITE_NUXT_ORIGIN_URL = http://localhost:5000  VITE_NUXT_API_PREFIX = /api/v1

VITE_NUXT_PREFIX_PATH = /blog-api
VITE_NUXT_OPEN_ENCRYPT = false

# 本地开发静态资源（上传后预览用，Go 网关 /static）
VITE_NUXT_STATIC_ORIGIN_URL = http://localhost:8000

# AI 文章摘要工具（Nitro 服务端使用，勿加 VITE_ 前缀）
# AI_SUMMARY_API_KEY = sk-xxx

# node 中express session用pm2多核部署时，并发大时会造成session被重写。
# https://cnodejs.org/topic/53683f214f5bf53561006824
