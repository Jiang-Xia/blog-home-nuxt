VITE_ENV = development

# 本地 Nest（blog-server → :5000）；本仓库前台只对接 Nest，不对接 Go
VITE_NUXT_ORIGIN_URL = http://localhost:5000
VITE_NUXT_API_PREFIX = /api/v1
VITE_NUXT_ADMIN_URL = http://localhost:9856
# Nest 实时推送为 Socket.IO（默认原生 WS 仅用于 blog-server-go）
VITE_NUXT_USE_SOCKET_IO = true

# --- 其他联调场景 ---
# 线上 Nest：pnpm dev:nest-online（见 .env.nest-online）
# 线上 Go 单体：pnpm dev:go-online（见 .env.go-online）

VITE_NUXT_PREFIX_PATH = /blog-api
VITE_NUXT_OPEN_ENCRYPT = false

# 本地开发静态资源（上传后预览用，Nest /static）
VITE_NUXT_STATIC_ORIGIN_URL = http://localhost:5000

# AI 文章摘要工具（Nitro 服务端使用，勿加 VITE_ 前缀）
# AI_SUMMARY_API_KEY = sk-xxx

# node 中express session用pm2多核部署时，并发大时会造成session被重写。
# https://cnodejs.org/topic/53683f214f5bf53561006824
