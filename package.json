{
  "name": "blog-home-nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nuxt build --dotenv .env.production",
    "build:docker": "nuxt build --dotenv .env.docker.production",
    "build:test": "nuxt build --dotenv .env.test",
    "build:report": "nuxt analyze",
    "dev": "nuxt dev --port 5050 --dotenv .env.development",
    "dev:nest-online": "nuxt dev --port 5050 --dotenv .env.nest-online",
    "dev:go-online": "nuxt dev --port 5050 --dotenv .env.go-online",
    "dev:ip": "nuxt dev --port 5050 --host 0.0.0.0 --dotenv .env.development",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy/pm2/deploy.ps1",
    "rollback": "powershell -ExecutionPolicy Bypass -File deploy/pm2/rollback.ps1",
    "rollback:list": "powershell -ExecutionPolicy Bypass -File deploy/pm2/rollback.ps1 -List",
    "generate": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview --dotenv .env.development",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prettier": "prettier . --write",
    "pm2:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "font:subset": "node scripts/font/build-subset.mjs"
  },
  "dependencies": {
    "@ai-sdk/vue": "^3.0.286",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/sitemap": "^8.5.1",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "ai": "^6.0.286",
    "copy-to-clipboard": "^4.0.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.8",
    "jsencrypt": "^3.5.4",
    "md-editor-v3": "^7.0.0",
    "modern-screenshot": "^4.7.0",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "sm-crypto": "^0.5.7",
    "socket.io-client": "^4.8.3",
    "sse.js": "^2.8.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inspira-ui/plugins": "^0.0.2",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.42",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vconsole": "^3.15.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "flatted": "3.4.4",
    "archiver-utils": {
      "glob": "10.5.0"
    },
    "markdown-it": {
      "linkify-it": "5.0.2"
    },
    "engine.io-client": {
      "ws": "8.21.3"
    },
    "socket.io-client": {
      "socket.io-parser": "4.2.7"
    }
  }
}
