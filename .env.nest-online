# 本地前端 dev → 线上 Nest（Nginx /x-blog/api/v1）
# 用法：pnpm dev:nest-online / yarn dev:nest-online
# 浏览器 /blog-api → Nitro devProxy → https://jiang-xia.top/x-blog/api/v1
# 实时推送：Socket.IO 直连 jiang-xia.top（须线上 serve_corsOrigins 含 localhost:5050）
# 加密：本地联调关加密；若线上强制加密可改 VITE_NUXT_OPEN_ENCRYPT=true

VITE_ENV = development

VITE_NUXT_ORIGIN_URL = https://jiang-xia.top
VITE_NUXT_API_PREFIX = /x-blog/api/v1
VITE_NUXT_ADMIN_URL = http://localhost:9856
VITE_NUXT_USE_SOCKET_IO = true

VITE_NUXT_PREFIX_PATH = /blog-api
VITE_NUXT_OPEN_ENCRYPT = false

VITE_NUXT_STATIC_ORIGIN_URL = https://jiang-xia.top
